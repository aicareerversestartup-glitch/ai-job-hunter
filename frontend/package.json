{
  "name": "ai-job-hunter-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:app": "vite build --mode app",
    "cap:sync": "npm run build:app && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@fontsource/sora": "^5.1.0",
    "@fontsource/instrument-sans": "^5.1.0",
    "@capacitor-community/admob": "^8.2.0",
    "@revenuecat/purchases-capacitor": "latest",
    "@revenuecat/purchases-js": "latest"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
