# ---- Public deployment (docker compose) ----
DOMAIN=jobs.example.com
PUBLIC_URL=https://jobs.example.com
OPERATOR_NAME=Your Company Name          # shown in the Privacy Policy and Terms
SUPPORT_EMAIL=support@example.com
# Password-reset emails (any SMTP service: Brevo, Mailgun, SES, Zoho...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Core ----
APP_ENV=development                 # set to "production" for deployments
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional separate key for encrypting stored API keys (defaults to SECRET_KEY)
ENCRYPTION_KEY=
# SQLite is used when DATABASE_URL is empty. Docker Compose sets PostgreSQL automatically.
DATABASE_URL=
POSTGRES_PASSWORD=change-me
ALLOW_REGISTRATION=true             # public app: anyone can sign up
ACCESS_TOKEN_MINUTES=720
MAX_UPLOAD_MB=10

# ---- Discovery ----
RUN_SCHEDULER=true
DISCOVERY_INTERVAL_HOURS=12
# Free key from https://developer.adzuna.com (optional)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Free key from https://jooble.org/api/about (covers UAE, Gulf and many more countries)
JOOBLE_API_KEY=

# ---- Interview email tracking ----
INBOX_CHECK_MINUTES=60

# ---- Default AI provider (each user can override in AI settings) ----
# none | openai | anthropic | gemini | ollama | openai_compatible
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=

# ---- Application assistant ----
# Visible browser so you can take over at CAPTCHAs/sign-ins. Must be false to assist on your desktop.
PLAYWRIGHT_HEADLESS=false
# Allows "submit for me" (still requires your approval per application, and never on CAPTCHA/login pages).
ALLOW_AUTO_SUBMIT=false

# ---- Plans and limits ----
FREE_DRAFTS_PER_DAY=10
MAX_DRAFTS_PER_DAY=40          # Pro
FREE_SEARCHES_PER_DAY=3
PRO_SEARCHES_PER_DAY=12
REWARD_AD_BONUS=5
REWARD_ADS_PER_DAY=2
REFERRAL_PRO_DAYS=7
SERVER_AI_FOR_FREE_USERS=false # your AI key costs money per call; by default only Pro uses it

# ---- Payments (RevenueCat: Apple, Google Play, web) ----
REVENUECAT_SECRET_KEY=         # sk_... (server only, never in the app)
REVENUECAT_WEBHOOK_AUTH=       # any long random string; paste the same value in RevenueCat > Webhooks > Authorization
REVENUECAT_PUBLIC_IOS=         # appl_...
REVENUECAT_PUBLIC_ANDROID=     # goog_...
REVENUECAT_PUBLIC_WEB=         # rcb_... (Web Billing)
PRO_ENTITLEMENT=pro

# ---- Ads ----
ADS_ENABLED=false
ADS_TEST_MODE=true             # keep true until AdMob/AdSense approve your app and site
ADSENSE_CLIENT=                # ca-pub-...
ADSENSE_SLOT_WAITING=
ADSENSE_SLOT_FEED=
ADMOB_PUBLISHER_ID=            # pub-... (for app-ads.txt)
ADMOB_BANNER_ANDROID=          # ca-app-pub-.../...
ADMOB_BANNER_IOS=
ADMOB_REWARDED_ANDROID=
ADMOB_REWARDED_IOS=
